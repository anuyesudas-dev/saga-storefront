# Secret material for the Kubernetes deployment.
#
#   cp deploy/k8s/.secrets.env.example deploy/k8s/.secrets.env   # then edit
#
# deploy/k8s/.secrets.env is gitignored; kustomize generates the
# platform-secrets Secret from it at apply time. Keep MONGODB_PASSWORD
# URL-safe (it is embedded in a connection string).

MONGODB_USERNAME=root
MONGODB_PASSWORD=change-me-url-safe
# internal auth key for the MongoDB replica set (any 16-1024 char base64
# string); generate a fresh one with:  openssl rand -base64 96 | tr -d '\n'
MONGO_KEYFILE=change-me-generate-with-openssl-rand

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

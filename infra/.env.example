# Environment-specific configuration for the Docker Compose stack.
#
#   cp infra/.env.example infra/.env     # then edit infra/.env
#
# Compose loads infra/.env automatically (it sits next to docker-compose.yml).
# infra/.env is gitignored — real values, especially credentials, never land
# in version control. Every variable has a safe local default baked into
# docker-compose.yml, so the stack runs without a .env file at all.
#
# Spring-level settings (Mongo URIs, Kafka bootstrap, retry tuning) follow the
# same pattern one level down: application.yml holds non-secret defaults, and
# any of them can be overridden per environment with standard Spring env vars,
# e.g. SPRING_DATA_MONGODB_URI, added under a service's `environment:` block.

# --- host port mappings (change when a port is already taken on your machine)
KAFKA_HOST_PORT=29092
MONGO_HOST_PORT=27017
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
AUTH_SERVICE_PORT=8085
API_GATEWAY_PORT=8080
FRONTEND_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Grafana auth (defaults are local-only convenience: anonymous Admin)
# For anything beyond a laptop: disable anonymous, enable basic auth, and set
# a real password HERE (never in a committed file).
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ROLE=Admin
GRAFANA_BASIC_AUTH_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin
